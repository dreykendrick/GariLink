# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DATABASE_URL="postgresql://garilink:garilink_dev_password@localhost:5432/garilink_dev?schema=public"
DB_USER=garilink
DB_PASSWORD=garilink_dev_password
DB_NAME=garilink_dev
DB_PORT=5432

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_LENGTH=6

# Account Lockout
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=60
AUTH_THROTTLE_LIMIT=10

# Media / Storage
MEDIA_STORAGE_PROVIDER=local
MEDIA_LOCAL_PATH=./uploads
MEDIA_MAX_FILE_SIZE_MB=10
MEDIA_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
MEDIA_ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime
MEDIA_ALLOWED_DOC_TYPES=application/pdf
MEDIA_MAX_IMAGES_PER_VEHICLE=20
MEDIA_PUBLIC_BASE_URL=http://localhost:3000/uploads

# AWS S3 (production)
# MEDIA_STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=af-south-1
# AWS_S3_BUCKET=garilink-media

# Cloudflare R2 (alternative production)
# MEDIA_STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=garilink-media
# R2_PUBLIC_URL=

# Email
EMAIL_PROVIDER=console
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=

# SMS
SMS_PROVIDER=console
# SMS_PROVIDER=africastalking
# AT_API_KEY=
# AT_USERNAME=
# AT_SENDER_ID=GariLink

# Cors
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Redis (future — event bus / caching)
REDIS_HOST=localhost
REDIS_PORT=6379
