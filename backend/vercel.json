{
  "version": 2,
  "buildCommand": "npm run build",
  "builds": [
    {
      "src": "api/handler.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["dist/**"]
      }
    },
    {
      "src": "api/test.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/test",
      "dest": "api/test.js"
    },
    {
      "src": "/(.*)",
      "dest": "api/handler.js"
    }
  ]
}
