// GariLink — Prisma Schema
// Sprint 1-4 foundation + Sprint 5 refinements
// Architecture: Clean Architecture + DDD
// Database: PostgreSQL 16

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  PRIVATE_OWNER
  DEALER
  MECHANIC
  INSPECTOR
  ADMIN
}

enum CapabilityType {
  // Identity capabilities
  LIST_VEHICLES
  MANAGE_LISTINGS
  MANAGE_RENTAL_LISTINGS
  MANAGE_FLEET
  PERFORM_INSPECTIONS
  PERFORM_REPAIRS
  // Admin capabilities
  ADMIN
}

enum CapabilityStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
  REJECTED
}

enum OtpPurpose {
  PHONE_VERIFICATION
  PASSWORD_RESET
  LOGIN_2FA
  EMAIL_VERIFICATION
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

// ─── Workspace ───
enum WorkspaceType {
  PERSONAL
  DEALERSHIP
  RENTAL_COMPANY
  FLEET_OWNER
  GARAGE
  LOGISTICS
  SPARE_PARTS
  INSURANCE
}

enum WorkspaceMemberRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

enum WorkspaceMemberStatus {
  ACTIVE
  SUSPENDED
  LEFT
}

// ─── Organization ───
enum OrganizationMemberRole {
  OWNER
  ADMINISTRATOR
  MANAGER
  MEMBER
}

enum OrganizationMemberStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

// ─── Verification ───
enum VerificationSubjectType {
  USER
  ORGANIZATION
  WORKSPACE
}

enum VerificationType {
  PHONE
  EMAIL
  NATIONAL_ID
  PASSPORT
  DRIVING_LICENSE
  BUSINESS_REGISTRATION
  KRA_PIN
  VEHICLE_LOGBOOK
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

// ─── Vehicle ───
enum VehicleStatus {
  DRAFT
  AVAILABLE
  UNAVAILABLE
  UNDER_MAINTENANCE
  RETIRED
  ARCHIVED
}

enum VehicleType {
  CAR
  TRUCK
  BUS
  MOTORCYCLE
  TRAILER
  OTHER
}

enum BodyType {
  SEDAN
  HATCHBACK
  COUPE
  ESTATE
  CONVERTIBLE
  SUV
  CROSSOVER
  PICKUP
  VAN
  MINIVAN
  BUS
  TRUCK
  TRACTOR
  TRAILER
  OTHER
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  LPG
  CNG
  OTHER
}

enum Transmission {
  AUTOMATIC
  MANUAL
  CVT
  SEMI_AUTO
  OTHER
}

enum Drivetrain {
  FWD
  RWD
  AWD
  FOUR_WD
  OTHER
}

enum VehicleCondition {
  NEW
  FOREIGN_USED
  LOCAL_USED
  SALVAGE
}

enum TrackingStatus {
  ACTIVE
  INACTIVE
  OFFLINE
  TAMPERED
}

// ─── Marketplace / Listing ───
enum ListingType {
  FOR_SALE
  FOR_HIRE
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  PAUSED
  EXPIRED
  SOLD
  ARCHIVED
}

enum InquiryStatus {
  PENDING
  ACCEPTED
  DECLINED
  CLOSED
}

enum FuelPolicy {
  FULL_TO_FULL
  FULL_TO_EMPTY
  PREPAID
  INCLUDED
}

enum CancellationPolicy {
  FLEXIBLE
  MODERATE
  STRICT
}

enum Currency {
  TZS
  KES
  USD
  EUR
  OTHER
}

enum BlockType {
  BOOKED
  MAINTENANCE
  OWNER_BLOCKED
}

// ─── Settings ───
enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

// ─────────────────────────────────────────────
// IDENTITY DOMAIN
// ─────────────────────────────────────────────

model User {
  id                  String    @id @default(cuid())
  email               String?   @unique
  phoneNumber         String    @unique
  passwordHash        String
  isEmailVerified     Boolean   @default(false)
  isPhoneVerified     Boolean   @default(false)
  isActive            Boolean   @default(true)
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  roles         UserRoleRecord[]
  capabilities  UserCapability[]
  profile       Profile?
  sessions      Session[]
  refreshTokens RefreshToken[]
  otps          Otp[]

  // Workspace
  ownedWorkspaces      Workspace[]       @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]

  // Organization
  ownedOrganizations  Organization[]           @relation("OrganizationOwner")
  organizationMembers OrganizationMember[]
  sentInvitations     OrganizationInvitation[] @relation("InvitationSender")

  // Media
  uploadedMedia Media[]

  // Marketplace
  savedVehicles  SavedVehicle[]
  savedListings  SavedListing[]
  contactIntents ContactIntent[]
  listings       Listing[]
  rentalRequests RentalRequest[]

  inquiriesMade      Inquiry[] @relation("InquirerUser")
  inquiriesResponded Inquiry[] @relation("ResponderUser")

  // Audit
  auditLogs AuditLog[] @relation("AuditActor")

  // Rentals
  rentalRequestsMade  RentalRequest[]       @relation("RentalCustomer")
  rentalStatusChanges RentalStatusHistory[] @relation("StatusChanger")

  @@map("users")
}

model UserRoleRecord {
  id        String   @id @default(cuid())
  userId    String
  role      UserRole
  grantedAt DateTime @default(now())
  grantedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@map("user_roles")
}

model UserCapability {
  id              String           @id @default(cuid())
  userId          String
  type            CapabilityType
  status          CapabilityStatus @default(PENDING)
  grantedAt       DateTime?
  expiresAt       DateTime?
  suspendedAt     DateTime?
  suspendedReason String?
  revokedAt       DateTime?
  revokedReason   String?
  rejectedAt      DateTime?
  rejectionReason String?
  requestedAt     DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@index([status])
  @@map("user_capabilities")
}

model Profile {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  firstName               String?
  lastName                String?
  middleName              String?
  displayName             String?
  dateOfBirth             DateTime?
  gender                  Gender?
  bio                     String?
  photoUrl                String?
  county                  String?
  city                    String?
  country                 String    @default("KE")
  timezone                String    @default("Africa/Nairobi")
  language                String    @default("en")
  completionPercentage    Int       @default(0)
  notificationPreferences Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  deviceId     String?
  deviceName   String?
  ipAddress    String?
  userAgent    String?
  isActive     Boolean   @default(true)
  revokedAt    DateTime?
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([userId, isActive])
  @@map("sessions")
}

model RefreshToken {
  id                String   @id @default(cuid())
  token             String   @unique
  userId            String
  sessionId         String
  familyId          String
  isRevoked         Boolean  @default(false)
  expiresAt         DateTime
  replacedByTokenId String?  @unique
  createdAt         DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Otp {
  id          String     @id @default(cuid())
  phoneNumber String
  userId      String?
  purpose     OtpPurpose
  codeHash    String
  expiresAt   DateTime
  isVerified  Boolean    @default(false)
  attempts    Int        @default(0)
  lastSentAt  DateTime   @default(now())
  createdAt   DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phoneNumber, purpose])
  @@index([userId])
  @@map("otps")
}

// ─────────────────────────────────────────────
// WORKSPACE DOMAIN (Sprint 5)
// ─────────────────────────────────────────────

model Workspace {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  type           WorkspaceType
  ownerId        String
  organizationId String?       @unique
  isActive       Boolean       @default(true)
  isVerified     Boolean       @default(false)
  logoUrl        String?
  coverImageUrl  String?
  description    String?
  county         String?
  city           String?
  country        String        @default("KE")
  timezone       String        @default("Africa/Nairobi")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  owner          User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  organization   Organization?     @relation(fields: [organizationId], references: [id])
  members        WorkspaceMember[]
  vehicles       Vehicle[]
  listings       Listing[]
  rentalRequests RentalRequest[]

  settings      WorkspaceSettings[]
  verifications Verification[]      @relation("WorkspaceVerification")

  @@index([ownerId])
  @@index([type])
  @@index([slug])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String                @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceMemberRole
  status      WorkspaceMemberStatus @default(ACTIVE)
  joinedAt    DateTime              @default(now())
  invitedBy   String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

model WorkspaceSettings {
  id          String           @id @default(cuid())
  workspaceId String
  key         String
  value       String
  valueType   SettingValueType @default(STRING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("workspace_settings")
}

// ─────────────────────────────────────────────
// ORGANIZATION DOMAIN (Sprint 4)
// ─────────────────────────────────────────────

model Organization {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  type          WorkspaceType
  ownerId       String
  description   String?
  website       String?
  logoUrl       String?
  coverImageUrl String?
  isActive      Boolean       @default(true)
  isVerified    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  owner         User                     @relation("OrganizationOwner", fields: [ownerId], references: [id])
  workspace     Workspace?
  members       OrganizationMember[]
  invitations   OrganizationInvitation[]
  settings      OrganizationSettings[]
  verifications Verification[]           @relation("OrganizationVerification")

  @@index([ownerId])
  @@map("organizations")
}

model OrganizationMember {
  id             String                   @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationMemberRole
  status         OrganizationMemberStatus @default(ACTIVE)
  joinedAt       DateTime                 @default(now())
  suspendedAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model OrganizationInvitation {
  id             String                 @id @default(cuid())
  organizationId String
  token          String                 @unique @default(cuid())
  invitedBy      String
  inviteeEmail   String?
  inviteePhone   String?
  role           OrganizationMemberRole
  status         InvitationStatus       @default(PENDING)
  expiresAt      DateTime
  respondedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("InvitationSender", fields: [invitedBy], references: [id])

  @@index([organizationId])
  @@index([token])
  @@index([inviteeEmail])
  @@index([inviteePhone])
  @@map("organization_invitations")
}

model OrganizationSettings {
  id             String           @id @default(cuid())
  organizationId String
  key            String
  value          String
  valueType      SettingValueType @default(STRING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("organization_settings")
}

// ─────────────────────────────────────────────
// MEDIA DOMAIN (Sprint 4 — updated Sprint 5)
// Context-tagged approach: no enum for media type
// ─────────────────────────────────────────────

model Media {
  id              String    @id @default(cuid())
  uploaderId      String
  // Context tagging (replaces MediaPurpose enum — no migrations needed for new consumers)
  entityType      String // 'User' | 'Organization' | 'Workspace' | 'Vehicle' | 'Verification' | ...
  entityId        String
  subType         String // 'AVATAR' | 'LOGO' | 'COVER' | 'EXTERIOR_FRONT' | 'LOGBOOK' | ...
  // File metadata
  filename        String
  originalName    String
  mimeType        String // determines PHOTO / VIDEO / DOCUMENT classification
  sizeBytes       Int
  storageKey      String // path/key in storage provider
  publicUrl       String
  isPublic        Boolean   @default(true)
  // Image metadata
  width           Int?
  height          Int?
  // Video metadata
  durationSeconds Int?
  thumbnailUrl    String?
  // Document metadata
  pageCount       Int?
  // Deduplication
  checksum        String?
  // Lifecycle
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  uploader      User           @relation(fields: [uploaderId], references: [id])
  vehicleImages VehicleImage[]

  @@index([uploaderId])
  @@index([entityType, entityId])
  @@index([entityType, entityId, subType])
  @@map("media")
}

// ─────────────────────────────────────────────
// VERIFICATION DOMAIN (Sprint 4)
// ─────────────────────────────────────────────

model Verification {
  id               String                  @id @default(cuid())
  subjectType      VerificationSubjectType
  subjectId        String
  type             VerificationType
  status           VerificationStatus      @default(PENDING)
  documentMediaIds String[]
  expiresAt        DateTime?
  reviewedBy       String?
  reviewedAt       DateTime?
  reviewNote       String?
  rejectionReason  String?
  requestedAt      DateTime                @default(now())
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  // Optional FK relations for direct lookups
  organization Organization? @relation("OrganizationVerification", fields: [subjectId], references: [id], map: "verification_organization_fk")
  workspace    Workspace?    @relation("WorkspaceVerification", fields: [subjectId], references: [id], map: "verification_workspace_fk")

  @@index([subjectType, subjectId])
  @@index([status])
  @@map("verifications")
}

// ─────────────────────────────────────────────
// VEHICLE DOMAIN — CORE (Sprint 5)
// ─────────────────────────────────────────────

model Vehicle {
  id                    String           @id @default(cuid())
  // Ownership — workspace is the single ownership primitive
  workspaceId           String
  // Classification
  type                  VehicleType
  bodyType              BodyType
  // Identity
  make                  String
  model                 String
  year                  Int
  trim                  String?
  // Technical specs
  fuelType              FuelType
  transmission          Transmission
  drivetrain            Drivetrain
  engineCapacity        Int? // cc
  engineNumber          String?          @unique
  horsepower            Int?
  torque                Int?
  fuelTankCapacity      Int? // liters
  groundClearance       Int? // mm
  wheelbase             Int? // mm
  doors                 Int?
  seats                 Int?
  // Condition & mileage
  condition             VehicleCondition
  mileage               Int // kilometres
  // Appearance
  exteriorColor         String?
  interiorColor         String?
  // Legal identifiers
  vin                   String?          @unique
  registrationNumber    String?          @unique
  // Features (comfort, safety, technology)
  features              String[]
  // Description
  description           String?
  // Media Preparation
  primaryImageId        String?
  // Asset state (separate from listing state)
  status                VehicleStatus    @default(DRAFT)
  // Admin verification
  isVerified            Boolean          @default(false)
  verifiedAt            DateTime?
  verifiedBy            String?
  // ─── Tracking Foundation (fields only — no implementation yet) ───
  trackingEnabled       Boolean          @default(false)
  trackingStatus        TrackingStatus?
  trackingProvider      String? // 'CELLOCATOR' | 'TELTONIKA' | 'TRAMIGO' | ...
  trackingDeviceId      String?
  lastKnownLatitude     Float?
  lastKnownLongitude    Float?
  lastKnownAddress      String?
  lastLocationUpdatedAt DateTime?
  geofenceEnabled       Boolean          @default(false)
  // Audit
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id])
  images         VehicleImage[]
  listings       Listing[]
  rentalRequests RentalRequest[]

  savedBy            SavedVehicle[]
  contactIntents     ContactIntent[]
  availabilityBlocks VehicleAvailabilityBlock[]

  // ─── Reserved future relations (implemented in future sprints) ───
  // maintenanceRecords VehicleMaintenanceRecord[]
  // repairRecords      VehicleRepairRecord[]
  // inspectionRecords  VehicleInspectionRecord[]
  // insurancePolicies  VehicleInsurancePolicy[]
  // ownershipHistory   VehicleOwnershipHistory[]
  // documents          VehicleDocument[]
  // serviceRecords     VehicleServiceRecord[]

  @@index([workspaceId])
  @@index([type])
  @@index([make, model])
  @@index([make, model, year])
  @@index([status])
  @@index([condition])
  @@index([fuelType])
  @@map("vehicles")
}

model VehicleImage {
  id        String   @id @default(cuid())
  vehicleId String
  mediaId   String
  order     Int      @default(0)
  isPrimary Boolean  @default(false)
  caption   String?
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, mediaId])
  @@index([vehicleId])
  @@index([mediaId])
  @@map("vehicle_images")
}

model VehicleAvailabilityBlock {
  id        String    @id @default(cuid())
  vehicleId String
  startDate DateTime
  endDate   DateTime
  type      BlockType
  reason    String?
  createdAt DateTime  @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, startDate, endDate])
  @@map("vehicle_availability_blocks")
}

// ─────────────────────────────────────────────
// MARKETPLACE DOMAIN — CONSUMER (Sprint 5)
// ─────────────────────────────────────────────

model Listing {
  id              String        @id @default(cuid())
  vehicleId       String
  workspaceId     String
  listerId        String
  type            ListingType
  title           String
  description     String?
  currency        Currency      @default(TZS)
  askingPrice     Decimal?      @db.Decimal(12, 2)
  negotiable      Boolean       @default(true)
  status          ListingStatus @default(DRAFT)
  publishedAt     DateTime?
  expiresAt       DateTime?
  viewCount       Int           @default(0)
  saveCount       Int           @default(0)
  contactCount    Int           @default(0)
  isFeatured      Boolean       @default(false)
  featuredUntil   DateTime?
  conditionRating Int?
  conditionNotes  String?
  tags            String[]
  county          String?
  country         String
  searchVector    Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  vehicle        Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lister         User                 @relation(fields: [listerId], references: [id], onDelete: Cascade)
  inquiries      Inquiry[]
  savedBy        SavedListing[]
  rentalConfig   ListingRentalConfig?
  contactIntents ContactIntent[]
  rentalRequests RentalRequest[]

  @@index([vehicleId])
  @@index([workspaceId])
  @@index([status])
  @@map("listings")
}

model Inquiry {
  id            String        @id @default(cuid())
  listingId     String
  inquirerId    String
  status        InquiryStatus @default(PENDING)
  message       String
  offeredPrice  Decimal?      @db.Decimal(12, 2)
  offerCurrency String?
  respondedAt   DateTime?
  respondedById String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  listing     Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  inquirer    User    @relation("InquirerUser", fields: [inquirerId], references: [id], onDelete: Cascade)
  respondedBy User?   @relation("ResponderUser", fields: [respondedById], references: [id])

  @@index([listingId])
  @@index([inquirerId])
  @@map("inquiries")
}

model SavedListing {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  savedAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@map("saved_listings")
}

model ListingRentalConfig {
  id                 String             @id @default(cuid())
  listingId          String             @unique
  // Rates (KES)
  dailyRate          Decimal            @db.Decimal(12, 2)
  weeklyRate         Decimal?           @db.Decimal(12, 2)
  monthlyRate        Decimal?           @db.Decimal(12, 2)
  // Deposit
  depositRequired    Boolean            @default(false)
  depositAmount      Decimal?           @db.Decimal(12, 2)
  // Driver
  driverIncluded     Boolean            @default(false)
  driverDailyRate    Decimal?           @db.Decimal(12, 2)
  // Fuel
  fuelPolicy         FuelPolicy         @default(FULL_TO_FULL)
  // Duration constraints
  mileageLimitPerDay Int? // km; null = unlimited
  minimumRentalDays  Int                @default(1)
  maximumRentalDays  Int?
  advanceBookingDays Int                @default(1)
  // Pickup / delivery
  pickupCounty       String
  pickupCity         String?
  pickupLatitude     Float?
  pickupLongitude    Float?
  deliveryAvailable  Boolean            @default(false)
  deliveryRadius     Int? // km
  deliveryFee        Decimal?           @db.Decimal(12, 2)
  // Booking policy
  instantBooking     Boolean            @default(false)
  cancellationPolicy CancellationPolicy @default(MODERATE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("listing_rental_configs")
}

model SavedVehicle {
  id        String   @id @default(cuid())
  userId    String
  vehicleId String
  savedAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([userId, vehicleId])
  @@index([userId])
  @@index([vehicleId])
  @@map("saved_vehicles")
}

model ContactIntent {
  id        String   @id @default(cuid())
  vehicleId String
  listingId String
  userId    String
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listingId, userId])
  @@index([vehicleId])
  @@index([listingId])
  @@index([userId])
  @@map("contact_intents")
}

// ─────────────────────────────────────────────
// AUDIT DOMAIN (Sprint 4)
// ─────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  action      String // e.g. 'vehicle.listed', 'capability.granted', 'listing.published'
  actorId     String
  subjectType String // e.g. 'Vehicle', 'Listing', 'UserCapability'
  subjectId   String
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([subjectType, subjectId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// RENTAL DOMAIN (Sprint 5)
// ─────────────────────────────────────────────

enum RentalStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  READY_FOR_PICKUP
  ACTIVE
  COMPLETED
}

model RentalRequest {
  id          String       @id @default(cuid())
  customerId  String
  workspaceId String
  vehicleId   String
  listingId   String
  status      RentalStatus @default(REQUESTED)

  // Dates
  startDate DateTime
  endDate   DateTime

  // Pricing snapshot
  dailyRate     Decimal  @db.Decimal(12, 2)
  currency      Currency @default(TZS)
  totalAmount   Decimal  @db.Decimal(12, 2)
  depositAmount Decimal? @db.Decimal(12, 2)

  // Notes
  pickupNotes     String?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer      User                  @relation("RentalCustomer", fields: [customerId], references: [id])
  workspace     Workspace             @relation(fields: [workspaceId], references: [id])
  vehicle       Vehicle               @relation(fields: [vehicleId], references: [id])
  listing       Listing               @relation(fields: [listingId], references: [id])
  statusHistory RentalStatusHistory[]
  User          User?                 @relation(fields: [userId], references: [id])
  userId        String?

  @@index([customerId])
  @@index([workspaceId])
  @@index([vehicleId])
  @@index([status])
  @@map("rental_requests")
}

model RentalStatusHistory {
  id              String       @id @default(cuid())
  rentalRequestId String
  status          RentalStatus
  changedById     String
  reason          String?
  createdAt       DateTime     @default(now())

  rentalRequest RentalRequest @relation(fields: [rentalRequestId], references: [id], onDelete: Cascade)
  changedBy     User          @relation("StatusChanger", fields: [changedById], references: [id])

  @@index([rentalRequestId])
  @@index([createdAt])
  @@map("rental_status_history")
}
