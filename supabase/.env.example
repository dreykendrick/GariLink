# Server secrets only. Copy to .env locally; never include in the APK or Git.
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_ID=
SEND_SMS_HOOK_SECRET=
# Supabase supplies SUPABASE_URL and SUPABASE_ANON_KEY to Edge Functions.
# No service-role key is needed for the application API.
# Comma-separated browser origins. Native Android requests have no Origin.
CORS_ORIGINS=http://localhost:3000
# Server-only Google Routes API credential. Restrict to Routes API and set a quota.
GOOGLE_ROUTES_API_KEY=
