{
  "expo": {
    "name": "GariLink",
    "slug": "garilink",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "garilink",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0F172A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ke.co.garilink.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "ke.co.garilink.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "GariLink needs access to your camera to photograph vehicles."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GariLink needs access to your photos to upload vehicle images."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "GariLink needs your location to show nearby listings."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "http://192.168.1.104:3000/api/v1"
    }
  }
}
